---
/**
 * ModelsExplorer.astro — toolbar + crawlable models list (hairline rows).
 *
 * Catalog-list semantics: a single column of hairline-separated rows
 * (`ModelRow.astro`), not a card grid. Interactivity is vanilla JS in one
 * `<script>`:
 *   - filter:  toggle [hidden] on rows based on vendor/type/search
 *   - sort:    set row.style.order (default = source index; name A–Z =
 *              data-name-order; name Z–A = total − data-name-order)
 *   - URL sync: state ↔ URLSearchParams (?vendor=&type=&sort=&q=) so deep
 *              links like /models?type=multimodal land in the filtered state.
 */
import ModelRow from './ModelRow.astro';
import {
  usedVendors,
  vendorSlug,
  vendorDisplayName,
  totalModelCount,
  loadModels,
} from '../data/pricing.ts';
import { i18n, type Locale } from '../i18n.ts';

interface Props {
  locale?: Locale;
}

const { locale = 'zh' } = Astro.props as Props;
const t = i18n[locale];
const models = loadModels();
const vendors = usedVendors();
const total = totalModelCount();

// Precompute A–Z rank (0 = first alphabetically) for name sorting. Sort by the
// user-visible display name, not the API model ID.
const nameRank = new Map<string, number>();
[...models]
  .sort((a, b) =>
    a.displayName.toLowerCase().localeCompare(b.displayName.toLowerCase())
  )
  .forEach((m, i) => nameRank.set(m.model_name, i));

const types = [
  { slug: 'all', label: t.models.all },
  { slug: 'language', label: t.models.types.language },
  { slug: 'multimodal', label: t.models.types.multimodal },
  { slug: 'video', label: t.models.types.video },
];
---

<section class="explorer" id="explorer" aria-label={t.models.filterAria}>
  <div class="container explorer__inner">
    <div
      class="explorer__toolbar"
      data-toolbar
      data-counter-template={t.models.counter('__shown__', total)}
    >
      <div
        class="explorer__chips"
        role="group"
        aria-label={t.models.vendorAria}
      >
        <button type="button" class="chip is-active" data-vendor="all"
          >{t.models.all} <span class="chip__count mono">{total}</span></button
        >
        {
          vendors.map((v) => (
            <button type="button" class="chip" data-vendor={vendorSlug(v)}>
              {vendorDisplayName(v, locale)}
            </button>
          ))
        }
      </div>

      <div
        class="explorer__chips explorer__chips--type"
        role="group"
        aria-label={t.models.typeAria}
      >
        {
          types.map((tp) => (
            <button
              type="button"
              class={`chip chip--type${tp.slug === 'all' ? ' is-active' : ''}`}
              data-type={tp.slug}
            >
              {tp.label}
            </button>
          ))
        }
      </div>

      <div class="explorer__controls">
        <label class="explorer__search">
          <span class="sr-only">{t.models.searchLabel}</span>
          <svg
            width="14"
            height="14"
            viewBox="0 0 14 14"
            fill="none"
            aria-hidden="true"
          >
            <circle
              cx="6"
              cy="6"
              r="4.25"
              stroke="currentColor"
              stroke-width="1.4"></circle>
            <path
              d="M9.2 9.2L12 12"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"></path>
          </svg>
          <input
            type="search"
            placeholder={t.models.searchPlaceholder}
            data-search
            autocomplete="off"
          />
        </label>

        <label class="explorer__sort">
          <span class="sr-only">{t.models.sortLabel}</span>
          <select data-sort>
            <option value="default">{t.models.sortDefault}</option>
            <option value="name_asc">{t.models.sortNameAsc}</option>
            <option value="name_desc">{t.models.sortNameDesc}</option>
          </select>
        </label>
      </div>

      <p class="explorer__counter mono" data-counter>
        {t.models.counter(total, total)}
      </p>
    </div>

    <div class="models-table" data-grid>
      <div class="models-table__head" aria-hidden="true">
        <span class="models-table__th">{t.models.columns.name}</span>
        <span class="models-table__th">{t.models.columns.id}</span>
        <span class="models-table__th">{t.models.columns.type}</span>
        <span class="models-table__th models-table__th--num"
          >{t.models.columns.tpm}</span
        >
        <span class="models-table__th models-table__th--num"
          >{t.models.columns.rpm}</span
        >
      </div>

      <ol class="models-table__body">
        {
          models.map((m) => (
            <ModelRow
              model={m}
              locale={locale}
              nameOrder={nameRank.get(m.model_name) ?? 0}
            />
          ))
        }
        <li class="models-table__empty" data-empty hidden>
          <p class="mono">{t.models.empty}</p>
          <button type="button" class="link" data-reset>{t.models.reset}</button
          >
        </li>
      </ol>
    </div>
  </div>
</section>

<style>
  .explorer {
    background: var(--color-canvas);
    padding-block: clamp(32px, 4vw, 56px);
  }

  .explorer__inner {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .explorer__toolbar {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'vendor controls'
      'type    counter';
    gap: 16px 24px;
    align-items: center;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--color-hairline);
  }

  .explorer__chips {
    grid-area: vendor;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .explorer__chips--type {
    grid-area: type;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-hairline);
    background: var(--color-canvas);
    color: var(--color-ink-secondary);
    font-size: 12.5px;
    letter-spacing: -0.005em;
    transition:
      background-color var(--motion-base) var(--ease-out-quart),
      border-color var(--motion-base) var(--ease-out-quart),
      color var(--motion-base) var(--ease-out-quart);
  }
  .chip:hover {
    border-color: var(--color-hairline-strong);
    color: var(--color-ink);
  }
  .chip.is-active {
    background: var(--color-ink);
    color: var(--color-on-primary);
    border-color: var(--color-ink);
  }
  .chip__count {
    font-size: 11px;
    color: var(--color-ink-mute);
    margin-left: 2px;
  }
  .chip.is-active .chip__count {
    color: var(--color-on-dark-mute);
  }
  .chip--type {
    font-size: 11px;
    padding: 5px 10px;
  }

  .explorer__controls {
    grid-area: controls;
    display: flex;
    gap: 10px;
    align-items: center;
    justify-self: end;
  }

  .explorer__search {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-hairline);
    background: var(--color-canvas);
    color: var(--color-ink-mute);
    min-width: 200px;
    transition: border-color var(--motion-base) var(--ease-out-quart);
  }
  .explorer__search:focus-within {
    border-color: var(--color-primary);
    color: var(--color-ink);
  }
  .explorer__search input {
    flex: 1;
    border: 0;
    outline: 0;
    background: transparent;
    font-size: 13px;
    min-width: 0;
  }
  .explorer__search input::placeholder {
    color: var(--color-ink-mute);
  }

  .explorer__sort select {
    padding: 8px 28px 8px 12px;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-hairline);
    background: var(--color-canvas);
    font-size: 13px;
    color: var(--color-ink);
    appearance: none;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='10' height='6' viewBox='0 0 10 6' fill='none'><path d='M1 1l4 4 4-4' stroke='%23273951' stroke-width='1.3' stroke-linecap='round' stroke-linejoin='round'/></svg>");
    background-repeat: no-repeat;
    background-position: right 10px center;
    cursor: pointer;
  }

  .explorer__counter {
    grid-area: counter;
    font-size: 11px;
    color: var(--color-ink-mute);
    justify-self: end;
  }

  /* ── models table ────────────────────────────────────────────────────── */
  /* CSS vars are inherited by ModelRow's <li> so head and rows share the
     same column tracks, cell padding, and gap → columns stay aligned. */
  .models-table {
    /* TPM/RPM are fixed-width so the flexible name/id/type columns don't
       reflow when a row's RPM value is shorter (e.g. 60 vs 500) — otherwise
       the TPM column shifts horizontally between rows. Widths fit the widest
       values (TPM 20,000,000 / RPM 4,000). */
    --models-grid-cols: 1.4fr 1.4fr 0.8fr 100px 60px;
    --models-cell-px: 16px;
    --models-gap: 16px;
    display: flex;
    flex-direction: column;
  }

  .models-table__head {
    display: grid;
    grid-template-columns: var(--models-grid-cols);
    column-gap: var(--models-gap);
    padding: 12px var(--models-cell-px);
    border-bottom: 1px solid var(--color-hairline-strong);
  }

  .models-table__th {
    text-transform: uppercase;
    letter-spacing: var(--type-eyebrow-track);
    font-size: var(--type-micro-size);
    color: var(--color-ink-mute);
    min-width: 0;
  }
  .models-table__th--num {
    text-align: right;
    justify-self: end;
  }

  .models-table__body {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .models-table__empty {
    text-align: center;
    padding: 64px 0;
    color: var(--color-ink-mute);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }
  .models-table__empty[hidden] {
    display: none;
  }

  @media (max-width: 768px) {
    .models-table__head {
      display: none;
    }
  }

  @media (max-width: 880px) {
    .explorer__toolbar {
      grid-template-columns: 1fr;
      grid-template-areas:
        'vendor'
        'type'
        'controls'
        'counter';
    }
    .explorer__controls {
      justify-self: stretch;
      flex-wrap: wrap;
    }
    .explorer__search {
      flex: 1;
    }
    .explorer__counter {
      justify-self: start;
    }
  }
</style>

<script>
  type SortKey = 'default' | 'name_asc' | 'name_desc';

  interface State {
    vendor: string;
    type: string;
    sort: SortKey;
    q: string;
  }

  const toolbar = document.querySelector<HTMLElement>('[data-toolbar]');
  const grid = document.querySelector<HTMLElement>('[data-grid]');
  if (!toolbar || !grid) {
    // ModelsExplorer not mounted — bail.
  } else {
    const rows = Array.from(grid.querySelectorAll<HTMLElement>('.modelrow'));
    const empty = grid.querySelector<HTMLElement>('[data-empty]');
    const total = rows.length;
    const searchInput =
      document.querySelector<HTMLInputElement>('[data-search]');
    const sortSelect = document.querySelector<HTMLSelectElement>('[data-sort]');
    const vendorChips = Array.from(
      document.querySelectorAll<HTMLButtonElement>('.chip[data-vendor]')
    );
    const typeChips = Array.from(
      document.querySelectorAll<HTMLButtonElement>('.chip[data-type]')
    );
    const resetBtn = document.querySelector<HTMLElement>('[data-reset]');

    const initialOrder = new Map<HTMLElement, number>();
    rows.forEach((r, i) => initialOrder.set(r, i));

    const state: State = readUrlState();

    function readUrlState(): State {
      const p = new URLSearchParams(window.location.search);
      const sort = p.get('sort') as SortKey | null;
      const validSorts: SortKey[] = ['default', 'name_asc', 'name_desc'];
      return {
        vendor: p.get('vendor') || 'all',
        type: p.get('type') || 'all',
        sort: sort && validSorts.includes(sort) ? sort : 'default',
        q: p.get('q') || '',
      };
    }

    function writeUrlState() {
      const p = new URLSearchParams();
      if (state.vendor !== 'all') p.set('vendor', state.vendor);
      if (state.type !== 'all') p.set('type', state.type);
      if (state.sort !== 'default') p.set('sort', state.sort);
      if (state.q) p.set('q', state.q);
      const qs = p.toString();
      const url = window.location.pathname + (qs ? '?' + qs : '');
      window.history.replaceState(null, '', url);
    }

    function applyChipActive(
      chips: HTMLButtonElement[],
      attr: 'vendor' | 'type',
      value: string
    ) {
      chips.forEach((c) => {
        if (c.dataset[attr] === value) c.classList.add('is-active');
        else c.classList.remove('is-active');
      });
    }

    function render() {
      // Sync UI controls with state.
      applyChipActive(vendorChips, 'vendor', state.vendor);
      applyChipActive(typeChips, 'type', state.type);
      if (sortSelect && sortSelect.value !== state.sort)
        sortSelect.value = state.sort;
      if (searchInput && searchInput.value !== state.q)
        searchInput.value = state.q;

      const q = state.q.trim().toLowerCase();
      let shown = 0;

      rows.forEach((row) => {
        const v = row.dataset.vendor || '';
        const tp = row.dataset.type || '';
        const name = row.dataset.name || '';
        const visible =
          (state.vendor === 'all' || v === state.vendor) &&
          (state.type === 'all' || tp === state.type) &&
          (q === '' || name.includes(q));
        row.hidden = !visible;
        if (visible) shown++;

        // sort key
        let order = initialOrder.get(row) ?? 0;
        if (state.sort === 'name_asc') {
          order = Number(row.dataset.nameOrder ?? 0);
        } else if (state.sort === 'name_desc') {
          order = total - Number(row.dataset.nameOrder ?? 0);
        }
        row.style.order = String(order);
      });

      const counter = document.querySelector<HTMLElement>('[data-counter]');
      const template = toolbar?.dataset.counterTemplate || '__shown__';
      if (counter)
        counter.textContent = template.replace('__shown__', String(shown));
      if (empty) empty.hidden = shown !== 0;
    }

    vendorChips.forEach((c) => {
      c.addEventListener('click', () => {
        state.vendor = c.dataset.vendor || 'all';
        writeUrlState();
        render();
      });
    });

    typeChips.forEach((c) => {
      c.addEventListener('click', () => {
        state.type = c.dataset.type || 'all';
        writeUrlState();
        render();
      });
    });

    sortSelect?.addEventListener('change', () => {
      state.sort = (sortSelect.value as SortKey) || 'default';
      writeUrlState();
      render();
    });

    let searchTimer: number | undefined;
    searchInput?.addEventListener('input', () => {
      window.clearTimeout(searchTimer);
      searchTimer = window.setTimeout(() => {
        state.q = searchInput.value;
        writeUrlState();
        render();
      }, 120);
    });

    resetBtn?.addEventListener('click', () => {
      state.vendor = 'all';
      state.type = 'all';
      state.sort = 'default';
      state.q = '';
      writeUrlState();
      render();
    });

    render();
  }
</script>
